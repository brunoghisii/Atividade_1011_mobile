# Copie para .env e preencha. NUNCA versione o arquivo .env.
NODE_ENV=development
PORT=3333
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Origens web permitidas (separadas por vírgula). O app mobile não envia Origin e não precisa estar aqui.
CORS_ORIGINS=http://localhost:8081
# Atrás de proxy reverso (nginx etc.)? Informe o número de saltos para o rate limit enxergar o IP real.
TRUST_PROXY=0
DB_FILE=./data/consultorio.db
UPLOAD_DIR=./data/uploads
